# TurboVec Enhanced — Required Environment Variables
# Copy this file to .env and fill in your API keys

# ─── LLM API Keys ───────────────────────────────────────────────
# Claude (primary) — https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (fallback) — https://platform.openai.com
OPENAI_API_KEY=sk-...

# ─── Ollama (offline/local) ─────────────────────────────────────
# Run: docker run -d -p 11434:11434 ollama/ollama
OLLAMA_BASE_URL=http://localhost:11434

# ─── Provider Override (optional) ───────────────────────────────
# Force a specific LLM provider (claude | openai | ollama)
# LLM_PROVIDER=claude

# Force a specific model
# LLM_MODEL=claude-sonnet-4-6

# ─── Vector DB Backends ──────────────────────────────────────────
# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Chroma
CHROMA_HOST=localhost
CHROMA_PORT=8000

# Weaviate
WEAVIATE_HOST=http://localhost:8080

# ─── Agent Configuration ────────────────────────────────────────
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# GPU: true | false (auto-detected if not set)
# USE_GPU=true

# HuggingFace cache directory
HF_HOME=./models
TRANSFORMERS_CACHE=./models
